---
const links = [
  { href: '/', label: 'Home' },
  { href: '/infrastructure-lab', label: 'Infrastructure Lab' },
  { href: '/projects', label: 'Projects' },
  { href: '/security-notes', label: 'Security Notes' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <nav
    class="mx-auto flex w-full max-w-7xl flex-col gap-4 border-b border-white/10 px-4 py-5 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8"
    aria-label="Primary navigation"
  >
    <a class="group flex flex-col text-white" href="/">
      <span class="text-base font-semibold">Afshin Saberi</span>
      <span class="text-xs text-cyan-200/70">Infrastructure Lab & Technical Portfolio</span>
    </a>
    <div class="flex flex-wrap gap-2 text-sm text-slate-300">
      {
        links.map((link) => (
          <a
            class="rounded-md border border-white/10 px-3 py-2 transition hover:border-cyan-300/40 hover:bg-cyan-300/10 hover:text-white"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
