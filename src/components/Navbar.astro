---
const links = [
  { href: '/', label: 'Home' },
  { href: '/infrastructure-lab', label: 'Infrastructure Lab' },
  { href: '/projects', label: 'Projects' },
  { href: '/security-notes', label: 'Security Notes' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <nav
    class="mx-auto w-full max-w-7xl border-b border-[color:var(--border)] px-4 py-4 sm:px-6 lg:px-8"
    aria-label="Primary navigation"
  >
    <div class="flex items-center justify-between gap-4">
      <a class="group flex min-w-0 flex-col text-[var(--text-strong)]" href="/">
        <span class="truncate text-base font-semibold">Afshin Saberi</span>
        <span class="truncate text-xs text-[var(--accent)] opacity-70">Infrastructure Lab & Technical Portfolio</span>
      </a>

      <div class="hidden items-center gap-2 text-sm text-[var(--text-soft)] lg:flex">
        {
          links.map((link) => (
            <a
              class="rounded-md border border-[color:var(--border)] px-3 py-2 transition hover:border-[color:var(--accent-border-hover)] hover:bg-[var(--accent-soft)] hover:text-[var(--text-strong)]"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
        <label class="sr-only" for="theme-select-desktop">Theme</label>
        <select
          id="theme-select-desktop"
          data-theme-select
          class="theme-select rounded-md px-3 py-2 text-sm transition"
          aria-label="Theme selector"
        >
          <option value="ops-dark">Ops Dark</option>
          <option value="terminal-green">Terminal Green</option>
          <option value="cloudflare-edge">Cloudflare Edge</option>
          <option value="clean-light">Clean Light</option>
        </select>
      </div>

      <button
        id="mobile-menu-button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-[color:var(--border)] bg-[var(--surface)] text-[var(--text-strong)] transition hover:border-[color:var(--accent-border-hover)] hover:bg-[var(--accent-soft)] lg:hidden"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <span class="sr-only">Open navigation menu</span>
        <span class="flex w-4 flex-col gap-1" aria-hidden="true">
          <span class="h-0.5 rounded-full bg-current"></span>
          <span class="h-0.5 rounded-full bg-current"></span>
          <span class="h-0.5 rounded-full bg-current"></span>
        </span>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="mt-4 rounded-lg border border-[color:var(--border)] bg-[var(--surface-strong)] p-3 shadow-2xl shadow-black/20 lg:hidden"
      hidden
    >
      <div class="grid gap-2 text-sm text-[var(--text-soft)]">
        {
          links.map((link) => (
            <a
              class="rounded-md border border-transparent px-3 py-3 transition hover:border-[color:var(--accent-border)] hover:bg-[var(--accent-soft)] hover:text-[var(--text-strong)]"
              href={link.href}
              data-mobile-link
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="mt-3 border-t border-[color:var(--border)] pt-3">
        <label class="mb-2 block text-xs font-medium text-[var(--text-faint)]" for="theme-select-mobile">Theme</label>
        <select
          id="theme-select-mobile"
          data-theme-select
          class="theme-select w-full rounded-md px-3 py-3 text-sm transition"
          aria-label="Theme selector"
        >
          <option value="ops-dark">Ops Dark</option>
          <option value="terminal-green">Terminal Green</option>
          <option value="cloudflare-edge">Cloudflare Edge</option>
          <option value="clean-light">Clean Light</option>
        </select>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button') as HTMLButtonElement | null;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLDivElement | null;
  const themeSelects = Array.from(document.querySelectorAll('[data-theme-select]')) as HTMLSelectElement[];
  const themes = ['ops-dark', 'terminal-green', 'cloudflare-edge', 'clean-light'];

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isOpen));
      menuButton.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
      mobileMenu.hidden = isOpen;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
        menuButton.setAttribute('aria-expanded', 'false');
        menuButton.setAttribute('aria-label', 'Open navigation menu');
        mobileMenu.hidden = true;
        menuButton.focus();
      }
    });

    document.querySelectorAll('[data-mobile-link]').forEach((link) => {
      link.addEventListener('click', () => {
        menuButton.setAttribute('aria-expanded', 'false');
        menuButton.setAttribute('aria-label', 'Open navigation menu');
        mobileMenu.hidden = true;
      });
    });
  }

  if (themeSelects.length > 0) {
    const currentTheme = document.documentElement.dataset.theme || 'ops-dark';
    const initialTheme = themes.includes(currentTheme) ? currentTheme : 'ops-dark';

    themeSelects.forEach((themeSelect) => {
      themeSelect.value = initialTheme;
      themeSelect.addEventListener('change', () => {
        document.documentElement.dataset.theme = themeSelect.value;
        localStorage.setItem('theme', themeSelect.value);
        themeSelects.forEach((select) => {
          select.value = themeSelect.value;
        });
      });
    });
  }
</script>
