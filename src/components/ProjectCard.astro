---
interface Props {
  title: string;
  problem: string;
  solution: string;
  technologies: string[];
  security: string;
  demonstrates: string;
}

const {
  title,
  problem,
  solution,
  technologies = [],
  security,
  demonstrates,
} = Astro.props as Props;
---

<article class="min-w-0 rounded-lg border border-[color:var(--border)] bg-[var(--surface)] p-6 shadow-2xl shadow-black/20">
  <h2 class="text-xl font-semibold text-[var(--text-strong)]">{title}</h2>
  <dl class="mt-5 space-y-4 text-sm leading-7">
    <div>
      <dt class="font-semibold text-[var(--accent)]">Problem</dt>
      <dd class="text-[var(--text-soft)]">{problem}</dd>
    </div>
    <div>
      <dt class="font-semibold text-[var(--accent)]">Solution</dt>
      <dd class="text-[var(--text-soft)]">{solution}</dd>
    </div>
    <div>
      <dt class="font-semibold text-[var(--accent)]">Operational boundary</dt>
      <dd class="text-[var(--text-soft)]">{security}</dd>
    </div>
    <div>
      <dt class="font-semibold text-[var(--accent)]">What it demonstrates</dt>
      <dd class="text-[var(--text-soft)]">{demonstrates}</dd>
    </div>
  </dl>
  <div class="mt-5 flex flex-wrap gap-2">
    {technologies.map((technology) => <span class="rounded-md bg-[var(--surface-hover)] px-2.5 py-1 text-xs text-[var(--text)]">{technology}</span>)}
  </div>
</article>
