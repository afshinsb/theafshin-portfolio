---
interface Props {
  title: string;
  summary: string;
  focus: string[];
  technologies: string[];
  links?: {
    label: string;
    href: string;
    variant?: 'primary' | 'secondary';
  }[];
}

const {
  title,
  summary,
  focus = [],
  technologies = [],
  links = [],
} = Astro.props as Props;
---

<article class="min-w-0 rounded-lg border border-[color:var(--border)] bg-[var(--surface)] p-6 shadow-2xl shadow-black/20">
  <h2 class="text-xl font-semibold text-[var(--text-strong)]">{title}</h2>
  <p class="mt-4 text-sm leading-6 text-[var(--text-soft)]">{summary}</p>
  <ul class="mt-5 space-y-2 text-sm leading-6 text-[var(--text-muted)]">
    {focus.map((item) => <li class="border-l border-[color:var(--accent-border)] pl-3">{item}</li>)}
  </ul>
  <div class="mt-5 flex flex-wrap gap-2">
    {technologies.map((technology) => <span class="rounded-md bg-[var(--surface-hover)] px-2.5 py-1 text-xs text-[var(--text)]">{technology}</span>)}
  </div>
  {
    links.length > 0 && (
      <div class="mt-6 flex min-w-0 flex-col gap-3 min-[430px]:flex-row min-[430px]:flex-wrap">
        {
          links.map((link) => (
            <a
              class:list={[
                'inline-flex w-full max-w-full justify-center rounded-md px-4 py-2.5 text-center text-sm font-semibold transition min-[430px]:w-auto',
                link.variant === 'primary'
                  ? 'bg-[var(--accent)] text-[var(--button-text)] hover:bg-[var(--accent-strong)]'
                  : 'border border-[color:var(--border-strong)] text-[var(--text-strong)] hover:border-[color:var(--accent-border-hover)] hover:bg-[var(--surface-hover)]',
              ]}
              href={link.href}
              rel="noreferrer"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    )
  }
</article>
