---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const primaryNotes = [
  {
    title: 'Production logs become data stores',
    body: 'Logs should explain failures without becoming a long-lived copy of sensitive request data.',
    detail: 'Useful fields: route, status, latency, correlation ID, and failure mode.',
    example: `logging:
  request_id: true
  include_headers: false
  include_body: false
  redact:
    - authorization
    - cookie
    - credential-header`,
  },
  {
    title: 'Backups are only useful after a restore works',
    body: 'A successful backup job is not enough. I care whether the service can be rebuilt from it.',
    detail: 'The restore path needs config, mounted data, service order, and verification checks.',
    example: `restore_test:
  target: isolated-host
  source: latest-snapshot
  verify:
    - service starts
    - healthcheck passes
    - sample data readable
    - rollback notes current`,
  },
  {
    title: 'Every public route adds operations work',
    body: 'Public exposure is not just a routing decision. It adds patching, monitoring, logging, and failure handling.',
    detail: 'Administration and maintenance workflows should stay on private access paths.',
    example: `routes:
  public:
    - service.example
  private:
    - admin-workflow
    - monitoring-workflow
    - automation-workflow`,
  },
];

const compactNotes = [
  {
    title: 'Private administration has a convenience cost',
    body: 'VPN/private access adds friction, so fallback access and device enrollment need to be thought through.',
  },
  {
    title: 'Docker networking creates trust boundaries',
    body: 'A Compose file can flatten trust quickly. I prefer small networks based on who actually needs to talk.',
  },
  {
    title: 'Reverse proxies need boring rules',
    body: 'Explicit host rules, narrow paths, predictable headers, and conservative defaults are easier to debug.',
  },
  {
    title: 'Automation should have a blast radius',
    body: 'Automation should have scoped access, predictable input/output, and logs that explain decisions.',
  },
  {
    title: 'Infrastructure drift is a security issue',
    body: 'Temporary ports, widened mounts, manual flags, and skipped updates become risk when they are not written down.',
  },
  {
    title: 'Fewer moving parts make failure paths easier to inspect and recover',
    body: 'A smaller stack is easier to review, monitor, roll back, and explain during troubleshooting.',
  },
];

const checklist = [
  'Can this service be rebuilt from documented config and recovery notes?',
  'Does the reverse proxy expose only the intended hostname and path?',
  'Can monitoring explain health without storing sensitive payloads?',
  'Is the admin path still usable if the public route is down?',
  'Are rollback steps written for the current version, not last month\'s layout?',
];
---

<Layout
  title="Operational Notes | Afshin Saberi"
  description="Operational notes about service exposure, logging, restore testing, Docker boundaries, private access, and constrained automation."
>
  <section class="min-w-0 py-10">
    <SectionHeader
      eyebrow="Operations"
      title="Operational Notes"
      description="Short notes on the operational habits behind the portfolio."
    />

    <div class="grid min-w-0 gap-5 lg:grid-cols-3">
      {
        primaryNotes.map((note) => (
          <article class="min-w-0 rounded-lg border border-[color:var(--border)] bg-[var(--surface)] p-6">
            <h2 class="text-lg font-semibold text-[var(--text-strong)]">{note.title}</h2>
            <p class="mt-3 text-sm leading-6 text-[var(--text-soft)]">{note.body}</p>
            <p class="mt-4 text-sm leading-6 text-[var(--text-muted)]">{note.detail}</p>
            <pre class="mt-5 max-w-full overflow-x-hidden whitespace-pre-wrap break-words rounded-md border border-[color:var(--terminal-border)] bg-[var(--surface-terminal-soft)] p-3 text-xs leading-6 text-[var(--terminal-text)] sm:overflow-x-auto"><code>{note.example}</code></pre>
          </article>
        ))
      }
    </div>

    <div class="mt-6 grid min-w-0 gap-5 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="grid min-w-0 gap-4 md:grid-cols-2">
        {
          compactNotes.map((note) => (
            <article class="min-w-0 rounded-lg border border-[color:var(--border)] bg-[var(--surface)] p-5">
              <h2 class="text-base font-semibold text-[var(--text-strong)]">{note.title}</h2>
              <p class="mt-3 text-sm leading-6 text-[var(--text-soft)]">{note.body}</p>
            </article>
          ))
        }
      </div>

      <aside class="rounded-lg border border-[color:var(--accent-border)] bg-[var(--accent-soft)] p-6">
        <h2 class="text-lg font-semibold text-[var(--text-strong)]">Operational review questions</h2>
        <ul class="mt-5 space-y-2 text-sm leading-6 text-[var(--text-soft)]">
          {checklist.map((item) => <li class="border-l border-[color:var(--accent-border-hover)] pl-4">{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>
</Layout>
