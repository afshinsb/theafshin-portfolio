---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const notes = [
  {
    title: 'How I Minimize Public Exposure',
    body: 'Start with private-by-default services, expose only what has a clear external purpose, and place public traffic behind managed edge controls.',
  },
  {
    title: 'Why Admin Tools Should Stay Private',
    body: 'Administrative interfaces are high-value targets. They belong behind private access workflows, not direct public routes.',
  },
  {
    title: 'Docker Secrets and Environment Hygiene',
    body: 'Secrets should not appear in repos, terminal examples, screenshots, logs, or shared configuration snippets.',
  },
  {
    title: 'Backup Strategy: Production Is Not Backup',
    body: 'Running data is not the same as recoverable data. A useful backup strategy includes restore testing and rollback notes.',
  },
  {
    title: 'Logging Without Leaking Sensitive Data',
    body: 'Logs should preserve operational signals while excluding tokens, usernames, internal paths, service URLs, and private identifiers.',
  },
];
---

<Layout title="Security Notes | Afshin Saberi">
  <section class="py-10">
    <SectionHeader
      eyebrow="Notes"
      title="Security Notes"
      description="Short practical notes about secure operations, privacy-preserving documentation, and infrastructure risk reduction."
    />
    <div class="grid gap-4 md:grid-cols-2">
      {
        notes.map((note) => (
          <article class="rounded-lg border border-white/10 bg-slate-950/70 p-6">
            <h2 class="text-lg font-semibold text-white">{note.title}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-300">{note.body}</p>
            <div class="mt-5 rounded-md border border-emerald-300/20 bg-black/40 p-3 font-mono text-xs text-emerald-200">
              sanitized_example: service.example
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
