---
import Layout from '../layouts/Layout.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import SectionHeader from '../components/SectionHeader.astro';

const sections = [
  {
    title: 'Ingress is a service dependency',
    body: 'A public hostname is part of the system, not just a DNS record. Tunnel health, proxy routing, TLS behavior, headers, and upstream readiness all need to be understandable when a request fails.',
  },
  {
    title: 'Private access needs fallback paths',
    body: 'VPN and private-access workflows reduce public surface area, but they add operational dependencies. Device enrollment, DNS behavior, and emergency access have to be documented before they are needed.',
  },
  {
    title: 'Docker networks define trust',
    body: 'Containers should not share a flat network by default. Reverse proxies, stateful services, automation jobs, and admin tools each need only the routes required for their role.',
  },
  {
    title: 'State changes need rollback notes',
    body: 'Version bumps, volume moves, proxy changes, and firewall edits should have a known way back. The useful note is the one that explains what changed and how to reverse it.',
  },
  {
    title: 'Monitoring should explain failure',
    body: 'Good signals answer narrow questions: is the service up, is the proxy reaching it, is storage healthy, did latency change, did auth fail unusually. More collection is not automatically better.',
  },
];
---

<Layout
  title="Infrastructure Lab | Afshin Saberi"
  description="Sanitized infrastructure lab showing tunnel-based exposure, reverse proxy boundaries, Docker service networks, private access, and restore-oriented operations."
>
  <section class="min-w-0 py-10">
    <SectionHeader
      eyebrow="Lab"
      title="Infrastructure Lab"
      description="A sanitized model of how I think about running small Linux service stacks: what is reachable, what depends on what, how admin access works, and what evidence helps during troubleshooting."
    />
    <ArchitectureDiagram />
    <div class="mt-8 grid min-w-0 gap-4 md:grid-cols-2">
      {
        sections.map((section) => (
          <article class="min-w-0 rounded-lg border border-[color:var(--border)] bg-[var(--surface)] p-6">
            <h2 class="text-lg font-semibold text-[var(--text-strong)]">{section.title}</h2>
            <p class="mt-3 text-sm leading-7 text-[var(--text-soft)]">{section.body}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
