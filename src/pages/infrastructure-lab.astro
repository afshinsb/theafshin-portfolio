---
import Layout from '../layouts/Layout.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import SectionHeader from '../components/SectionHeader.astro';

const sections = [
  {
    title: 'Public exposure strategy',
    body: 'Only selected public-facing services are reachable through protected edge controls. Origins stay hidden behind sanitized routing such as service.example.',
  },
  {
    title: 'Private access strategy',
    body: 'Administrative surfaces stay private through VPN-style access and internal-only names such as admin.internal and automation.internal.',
  },
  {
    title: 'Service isolation',
    body: 'Service groups are separated by Docker networks, role, and risk. Admin tools, media workflows, storage, and monitoring are treated as different trust zones.',
  },
  {
    title: 'Storage and backup planning',
    body: 'Storage planning assumes that live data is not a backup. Rollback paths, snapshots, and restore testing are part of the operating model.',
  },
  {
    title: 'Logging and monitoring',
    body: 'Monitoring focuses on health, availability, and security signals while avoiding sensitive values in logs, dashboards, and shared writeups.',
  },
];
---

<Layout title="Infrastructure Lab | Afshin Saberi">
  <section class="py-10">
    <SectionHeader
      eyebrow="Lab"
      title="Infrastructure Lab"
      description="A sanitized view of infrastructure patterns for Linux services, Docker networks, protected ingress, private administration, and operational visibility."
    />
    <ArchitectureDiagram />
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        sections.map((section) => (
          <article class="rounded-lg border border-white/10 bg-slate-950/70 p-6">
            <h2 class="text-lg font-semibold text-white">{section.title}</h2>
            <p class="mt-3 text-sm leading-7 text-slate-300">{section.body}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
