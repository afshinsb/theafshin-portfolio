---
import Layout from '../layouts/Layout.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import SectionHeader from '../components/SectionHeader.astro';

const sections = [
  {
    title: 'Ingress',
    body: 'DNS, tunnel health, proxy routing, and upstream readiness are checked as one request path.',
  },
  {
    title: 'Private Access',
    body: 'Admin tools stay behind private workflows, with fallback access considered before incidents.',
  },
  {
    title: 'Docker Boundaries',
    body: 'Service networks are based on required communication, not one broad shared network.',
  },
  {
    title: 'Rollback',
    body: 'Version, volume, proxy, and access changes need a known path back.',
  },
  {
    title: 'Visibility',
    body: 'Useful signals answer whether the service, proxy, storage, or access path is failing.',
  },
];

const operatingModel = [
  {
    label: 'Public ingress path',
    value: 'service.example -> tunnel -> reverse proxy -> service',
  },
  {
    label: 'Private administration workflow',
    value: 'VPN/private access before admin tools.',
  },
  {
    label: 'Reverse proxy boundary',
    value: 'Explicit host/path rules and safe defaults.',
  },
  {
    label: 'Monitored signals',
    value: 'Health, reachability, latency, storage pressure.',
  },
  {
    label: 'Restore path documentation',
    value: 'Config, data, service order, verification.',
  },
  {
    label: 'Isolated service networking',
    value: 'Small networks based on required communication.',
  },
];

const troubleshootingSteps = [
  'Change one layer at a time.',
  'Check DNS, proxy, service health, and logs separately.',
  'Keep recovery steps repeatable.',
];
---

<Layout
  title="Infrastructure Lab | Afshin Saberi"
  description="Sanitized infrastructure lab showing tunnel-based exposure, reverse proxy boundaries, Docker service networks, private access, and restore-oriented operations."
>
  <section class="min-w-0 py-10">
    <SectionHeader
      eyebrow="Lab"
      title="Infrastructure Lab"
      description="A sanitized snapshot of how I think about service exposure, private access, Docker boundaries, and recovery."
    />
    <ArchitectureDiagram />

    <section class="mt-8 min-w-0 rounded-lg border border-[color:var(--border)] bg-[var(--surface)] p-6">
      <div class="max-w-3xl">
        <p class="mb-3 text-sm font-semibold text-[var(--accent-strong)]">Sanitized Examples</p>
        <h2 class="text-2xl font-semibold tracking-normal text-[var(--text-strong)]">Example Operating Model</h2>
        <p class="mt-3 text-sm leading-6 text-[var(--text-soft)]">
          Sanitized examples only. No real addresses, private hostnames, ports, credentials, logs, or topology details.
        </p>
      </div>
      <div class="mt-6 grid min-w-0 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          operatingModel.map((item) => (
            <article class="min-w-0 rounded-md border border-[color:var(--border)] bg-[var(--surface-muted)] p-4">
              <h3 class="text-sm font-semibold text-[var(--accent)]">{item.label}</h3>
              <p class="mt-3 text-sm leading-6 text-[var(--text-soft)]">{item.value}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-8 min-w-0 rounded-lg border border-[color:var(--accent-border)] bg-[var(--accent-soft)] p-6">
      <h2 class="text-2xl font-semibold tracking-normal text-[var(--text-strong)]">Troubleshooting Approach</h2>
      <ul class="mt-5 space-y-2 text-sm leading-6 text-[var(--text-soft)]">
        {troubleshootingSteps.map((step) => <li class="border-l border-[color:var(--accent-border-hover)] pl-4">{step}</li>)}
      </ul>
    </section>

    <div class="mt-8 grid min-w-0 gap-4 md:grid-cols-2">
      {
        sections.map((section) => (
          <article class="min-w-0 rounded-lg border border-[color:var(--border)] bg-[var(--surface)] p-6">
            <h2 class="text-lg font-semibold text-[var(--text-strong)]">{section.title}</h2>
            <p class="mt-3 text-sm leading-6 text-[var(--text-soft)]">{section.body}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
