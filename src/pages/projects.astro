---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';

const projects = [
  {
    title: 'Universal Subtitle Translator',
    summary: 'A self-hosted AI subtitle translation app for local media workflows, with a simulated public demo for safe review.',
    focus: [
      'FastAPI service packaged for Docker Compose and Portainer deployment',
      'Authentication, configuration health, batch jobs, and operational logs',
      'Mounted media workflow keeps subtitle files on the host; public demo makes no uploads, API calls, or secret use',
    ],
    technologies: ['FastAPI', 'Docker', 'Docker Compose', 'Portainer', 'OpenAI API', 'Cloudflare Pages'],
    links: [
      {
        label: 'View Demo',
        href: 'https://translate.theafshin.com/',
        variant: 'primary',
      },
      {
        label: 'GitHub',
        href: 'https://github.com/afshinsb/universal-subtitle-translator',
      },
    ],
  },
  {
    title: 'Self-Hosted Service Stack',
    summary: 'A small Linux/Docker service environment focused on stable ingress, private administration, and service isolation.',
    focus: [
      'Reverse proxy routing with Cloudflare Tunnel-style exposure',
      'Docker networks split by required communication',
      'Health checks and rollback notes for updates',
    ],
    technologies: ['Linux', 'Docker', 'Reverse Proxy', 'Cloudflare Tunnel', 'DNS'],
  },
  {
    title: 'Constrained Automation Workflow',
    summary: 'Automation for repeatable file and service tasks, designed to be easy to inspect when something fails.',
    focus: [
      'Bounded inputs and predictable output locations',
      'Readable run state and retry behavior',
      'Logs that explain decisions without storing sensitive payloads',
    ],
    technologies: ['Python', 'PowerShell', 'Docker', 'Controlled APIs'],
  },
  {
    title: 'Storage-Backed Service Maintenance',
    summary: 'Operational care for stateful services where mounts, permissions, restore order, and storage pressure matter.',
    focus: [
      'Config and data treated as separate restore inputs',
      'Mounted paths and service order documented',
      'Storage health and service checks used during maintenance',
    ],
    technologies: ['Linux', 'Docker Volumes', 'Storage', 'Monitoring'],
  },
  {
    title: 'Private Administration Access',
    summary: 'Private access patterns for administration without turning internal tools into public services.',
    focus: [
      'VPN/private access before admin tools',
      'DNS and access-rule troubleshooting separated',
      'Fallback path considered for device or name-resolution issues',
    ],
    technologies: ['VPN', 'Tailscale', 'DNS', 'Network Access Rules'],
  },
  {
    title: 'Restore and Rollback Notes',
    summary: 'Recovery notes focused on whether a service can actually be rebuilt after a bad change or failed host.',
    focus: [
      'Config source, mounted data, and service order captured',
      'Restore verification instead of backup assumptions',
      'Rollback notes kept close to deployment changes',
    ],
    technologies: ['Backups', 'Snapshots', 'Linux', 'Documentation'],
  },
];
---

<Layout
  title="Projects | Afshin Saberi"
  description="Infrastructure project summaries focused on Linux service operations, Docker workloads, private access, automation constraints, and restore planning."
>
  <section class="min-w-0 py-10">
    <SectionHeader
      eyebrow="Work"
      title="Projects"
      description="A few representative areas of hands-on infrastructure work, kept sanitized and concise."
    />
    <div class="grid min-w-0 gap-5 lg:grid-cols-2">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>
</Layout>
