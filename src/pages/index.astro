---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TechBadge from '../components/TechBadge.astro';

const highlights = [
  {
    title: 'Linux / Docker Operations',
    body: 'I look past “it runs” and check restart behavior, mounted data, service health, logs, and update impact.',
  },
  {
    title: 'Exposure Control',
    body: 'I separate public service paths from admin access and reason through DNS, tunnels, proxy routes, and upstream health.',
  },
  {
    title: 'Restore / Rollback Thinking',
    body: 'I care whether a backup can become a working service again, with config, data, order, and verification documented.',
  },
];

const terminalLines = [
  'identity: Afshin Saberi',
  'focus: Linux services, Docker, access boundaries',
  'region: Canada-based',
  'public_route: service.example',
  'admin_route: private-access',
];
---

<Layout title="Afshin Saberi | Infrastructure & Systems Operations">
  <section class="grid min-w-0 gap-8 py-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:py-16">
    <div class="min-w-0">
      <p class="mb-4 text-sm font-semibold text-[var(--accent-strong)]">Infrastructure & Systems Operations</p>
      <h1 class="max-w-full text-4xl font-semibold tracking-normal text-[var(--text-strong)] sm:text-7xl">Afshin Saberi</h1>
      <p class="mt-4 max-w-full text-xl leading-8 text-[var(--text)] sm:text-2xl">Infrastructure / Systems / Security Engineer</p>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-[var(--text-soft)]">
        I run Linux services, Docker workloads, reverse-proxied ingress, private access paths,
        and practical automation with an operator’s eye for recovery.
      </p>
      <div class="mt-8 flex min-w-0 flex-col gap-3 min-[430px]:flex-row min-[430px]:flex-wrap">
        <a class="inline-flex w-full max-w-full justify-center rounded-md bg-[var(--accent)] px-4 py-3 text-center text-sm font-semibold text-[var(--button-text)] transition hover:bg-[var(--accent-strong)] min-[430px]:w-auto" href="/infrastructure-lab">View Infrastructure Lab</a>
        <a class="inline-flex w-full max-w-full justify-center rounded-md border border-[color:var(--border-strong)] px-4 py-3 text-center text-sm font-semibold text-[var(--text-strong)] transition hover:border-[color:var(--accent-border-hover)] hover:bg-[var(--surface-hover)] min-[430px]:w-auto" href="/projects">View Projects</a>
        <a class="inline-flex w-full max-w-full justify-center rounded-md border border-[color:var(--border-strong)] px-4 py-3 text-center text-sm font-semibold text-[var(--text-strong)] transition hover:border-[color:var(--accent-border-hover)] hover:bg-[var(--surface-hover)] min-[430px]:w-auto" href="/resume">Capabilities</a>
      </div>
      <div class="mt-8 flex min-w-0 flex-wrap gap-2">
        {['Linux', 'Docker', 'Reverse Proxy', 'Cloudflare Tunnel', 'VPN Access', 'Backups'].map((skill) => <TechBadge label={skill} />)}
      </div>
    </div>

    <div class="min-w-0 max-w-full rounded-lg border border-[color:var(--terminal-border)] bg-[var(--surface-terminal)] p-4 shadow-2xl shadow-black/30 sm:p-5">
      <div class="mb-4 flex gap-2">
        <span class="h-3 w-3 rounded-full bg-red-400"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-300"></span>
        <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
      </div>
      <pre class="max-w-full overflow-x-hidden whitespace-pre-wrap break-words text-xs leading-6 text-[var(--terminal-text)] sm:overflow-x-auto sm:text-sm sm:leading-7"><code>{terminalLines.map((line) => `> ${line}`).join('\n')}</code></pre>
    </div>
  </section>

  <section class="min-w-0 pt-10 pb-0">
    <SectionHeader
      eyebrow="At A Glance"
      title="How I work with infrastructure"
      description="Short signals for someone coming from my resume."
    />
    <div class="grid min-w-0 gap-4 md:grid-cols-3">
      {
        highlights.map((highlight) => (
          <article class="min-w-0 rounded-lg border border-[color:var(--border)] bg-[var(--surface)] p-6">
            <h2 class="text-lg font-semibold text-[var(--text-strong)]">{highlight.title}</h2>
            <p class="mt-3 text-sm leading-6 text-[var(--text-soft)]">{highlight.body}</p>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
