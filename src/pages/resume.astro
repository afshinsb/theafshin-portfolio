---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TechBadge from '../components/TechBadge.astro';

const skills = [
  'Linux',
  'Windows Server',
  'Docker',
  'Networking',
  'VPN',
  'Firewalls',
  'Python',
  'PowerShell',
  'Cloudflare',
  'ZFS',
  'Tailscale',
  'Security operations fundamentals',
];

const resumeSections = [
  {
    title: 'Infrastructure Operations',
    items: [
      'Linux-based service deployment and maintenance',
      'Dockerized application planning and service grouping',
      'Reverse proxy and protected ingress design',
    ],
  },
  {
    title: 'Security & Access',
    items: [
      'Private administration strategy for internal tools',
      'VPN and access policy planning',
      'Log and configuration hygiene for sensitive environments',
    ],
  },
  {
    title: 'Automation & Reliability',
    items: [
      'Python and PowerShell scripting for repeatable operations',
      'Backup, snapshot, and rollback planning',
      'Monitoring practices focused on actionable operational signals',
    ],
  },
];
---

<Layout title="Resume | Afshin Saberi">
  <section class="py-10">
    <SectionHeader
      eyebrow="Experience"
      title="Resume"
      description="Canada-based Infrastructure / Systems / Security Engineer focused on reliable systems, secure access patterns, automation, and practical operations."
    />
    <div class="grid gap-6 lg:grid-cols-[0.7fr_1.3fr]">
      <aside class="rounded-lg border border-white/10 bg-slate-950/70 p-6">
        <h2 class="text-xl font-semibold text-white">Afshin Saberi</h2>
        <p class="mt-2 text-slate-300">Infrastructure / Systems / Security Engineer</p>
        <p class="mt-2 text-sm text-cyan-200">Canada-based</p>
        <a class="mt-6 inline-flex rounded-md bg-cyan-300 px-4 py-3 text-sm font-semibold text-slate-950" href="#" aria-label="Download Resume PDF placeholder">Download Resume PDF</a>
        <div class="mt-6 flex flex-wrap gap-2">
          {skills.map((skill) => <TechBadge label={skill} />)}
        </div>
      </aside>

      <div class="space-y-4">
        {
          resumeSections.map((section) => (
            <section class="rounded-lg border border-white/10 bg-slate-950/70 p-6">
              <h2 class="text-lg font-semibold text-white">{section.title}</h2>
              <ul class="mt-4 space-y-3 text-sm leading-7 text-slate-300">
                {section.items.map((item) => <li class="border-l border-cyan-300/30 pl-4">{item}</li>)}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
