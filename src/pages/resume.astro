---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TechBadge from '../components/TechBadge.astro';

const skills = [
  'Linux',
  'Docker',
  'Reverse Proxying',
  'DNS Troubleshooting',
  'VPN / Private Access',
  'Python',
  'PowerShell',
  'Cloudflare Tunnel',
  'Backups / Restores',
  'Operational Logging',
];

const resumeSections = [
  {
    title: 'Infrastructure Operations',
    items: [
      'Linux service deployment, maintenance, package updates, and service health checks',
      'Dockerized workload operation with deliberate networks, volumes, and restart behavior',
      'Reverse proxy and tunnel-based ingress for selected public services',
    ],
  },
  {
    title: 'Access & Exposure Control',
    items: [
      'Private administration workflows using VPN-style access and internal hostnames',
      'DNS, firewall, and proxy troubleshooting for reachable and intentionally unreachable services',
      'Logging practices that preserve operational signal without publishing sensitive environment details',
    ],
  },
  {
    title: 'Automation & Reliability',
    items: [
      'Python and PowerShell automation for repeatable file, service, and maintenance workflows',
      'Backup, restore, snapshot, and rollback notes for stateful services',
      'Monitoring focused on service health, storage pressure, latency, and proxy reachability',
    ],
  },
];
---

<Layout
  title="Resume | Afshin Saberi"
  description="Canada-based Infrastructure, Systems, and Security Engineer focused on Linux service operations, Docker workloads, private access, automation, and restore planning."
>
  <section class="min-w-0 py-10">
    <SectionHeader
      eyebrow="Experience"
      title="Resume"
      description="Hands-on infrastructure and systems work focused on operating services, reducing unnecessary exposure, automating carefully, and keeping recovery paths understandable."
    />
    <div class="grid min-w-0 gap-6 lg:grid-cols-[0.7fr_1.3fr]">
      <aside class="min-w-0 rounded-lg border border-[color:var(--border)] bg-[var(--surface)] p-6">
        <h2 class="text-xl font-semibold text-[var(--text-strong)]">Afshin Saberi</h2>
        <p class="mt-2 text-[var(--text-soft)]">Infrastructure / Systems / Security Engineer</p>
        <p class="mt-2 text-sm text-[var(--accent)]">Canada-based</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {skills.map((skill) => <TechBadge label={skill} />)}
        </div>
      </aside>

      <div class="min-w-0 space-y-4">
        {
          resumeSections.map((section) => (
            <section class="min-w-0 rounded-lg border border-[color:var(--border)] bg-[var(--surface)] p-6">
              <h2 class="text-lg font-semibold text-[var(--text-strong)]">{section.title}</h2>
              <ul class="mt-4 space-y-3 text-sm leading-7 text-[var(--text-soft)]">
                {section.items.map((item) => <li class="border-l border-[color:var(--accent-border)] pl-4">{item}</li>)}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
